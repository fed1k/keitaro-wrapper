# Keitaro Admin API (key: Keitaro admin -> Profile -> API keys)
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=put-your-key-here

# Defaults for created campaigns (domain kylovoa.com, group FORTESTS, source FORTESTS)
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836

# Every campaign name gets this prefix
CAMPAIGN_PREFIX=test_allamurotov_

GOOGLE_URL=https://google.com
REPORT_TIMEZONE=Europe/Moscow

# SQLite by default; Postgres works too: postgresql+psycopg://user:pass@localhost/keitaro
DATABASE_URL=sqlite:///./keitaro_wrapper.db
